# NVIDIA API key from https://build.nvidia.com (used for speech-to-text and the LLM)
NVIDIA_API_KEY=
# Optional overrides
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_ASR_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# Telegram bot token from @BotFather and the channel chat id (e.g. -1001234567890 or @mychannel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Where the SQLite db and uploaded files live (default ./data)
DATA_DIR=
# Optional: override for local testing against a mock Bot API
# TELEGRAM_API_BASE=https://api.telegram.org
